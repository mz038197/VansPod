{
  "name": "vanspod",
  "version": "0.4.8",
  "bin": { "vanspod": "bin/vanspod.cjs" },
  "engines": { "node": ">=24" },
  "os": ["win32"],
  "files": ["bin/", "dist/**/*.js", "!dist/test/**", "!dist/sea-*.js", "media/brand-logo.png", "media/brand-icon.ico", "media/fadou-superhero.png", "media/fadou-superhero-blink.png", "scripts/tray.ps1", "scripts/uninstall.ps1", "scripts/update.ps1", "README.md"],
  "publishConfig": { "access": "public" },
  "description": "本機 VansPod。學生用系統瀏覽器兌換課堂連線。",
  "repository": { "type": "git", "url": "git+https://github.com/mz038197/VansPod.git" },
  "scripts": {
    "test": "tsc -p . && node --test dist/test/*.test.js",
    "typecheck": "tsc -p . --noEmit",
    "build": "tsc -p .",
    "start": "tsc -p . && node dist/entry.js",
    "prepack": "npm run build",
    "postinstall": "node bin/register.cjs",
    "dist": "node scripts/dist.mjs",
    "test:windows-exe": "npm run dist && node scripts/test-windows-exe.mjs",
    "test:lifecycle": "tsc -p . && node --test dist/test/launcher.test.js",
    "test:distribution": "npm run dist && node scripts/test-distribution.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
